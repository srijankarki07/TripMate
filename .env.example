# TripMate local settings.
#
# Copy to .env and edit. .env is not committed; this file is.
# Everything here is optional: each value falls back to the default shown.

# --- database --------------------------------------------------------------
# TM_DB_NAME=tripmate
# TM_DB_USER=tripmate
# TM_DB_PASSWORD=tripmate_dev_pw
# TM_DB_HOST=localhost
# TM_DB_PORT=5432

# --- mail ------------------------------------------------------------------
# With no host set, messages are rendered into the server log instead of sent.
# TM_MAIL_HOST=smtp.gmail.com
# TM_MAIL_PORT=587
# TM_MAIL_USER=you@example.com
# TM_MAIL_PASSWORD=
# TM_MAIL_FROM="TripMate <no-reply@example.com>"

# --- what the site shows ---------------------------------------------------
# The integration checks are a development tool, so the link to them is off
# unless a deployment asks for it.
TM_SHOW_DIAGNOSTICS=false

# The stack line under the footer. Written as plain text; the separator is a
# middle dot by convention.
TM_FOOTER_STACK=Jakarta EE 10 - GlassFish 7 - PostgreSQL

# --- Google Calendar connection --------------------------------------------
# An OAuth client from console.cloud.google.com, with the Calendar API enabled
# and this redirect address registered against it:
#
#   http://localhost:8080/calendar/google/callback
#
# Note the path: the application serves at the root, so there is no /tripmate
# in it. An earlier version of this file had one, which is exactly the kind of
# stale detail that costs an afternoon.
#
# On a real deployment this is the public address instead, and the consent
# screen's Authorized domains takes the registrable domain rather than the
# subdomain. docs/deployment.md section 8 has both.
#
# Leave the client id unset and the connection is simply not offered; the
# subscribe address still works. While the consent screen is in Testing, Google
# expires refresh tokens after seven days, so the connection stops working
# weekly until the app is published to Production.
# TM_GOOGLE_CLIENT_ID=
# TM_GOOGLE_CLIENT_SECRET=

# Encrypts stored refresh tokens, so a database dump is not a set of working
# credentials. 32 random bytes, base64. Generate one with:
#
#   openssl rand -base64 32
#
# Changing it does not lose the connections; it makes them unreadable, and
# every reader has to connect again.
# TM_CREDENTIALS_KEY=

# --- runtime tuning --------------------------------------------------------
# Applied to the GlassFish domain by scripts/glassfish-tune.sh, which deploy.sh
# runs on every deployment. The defaults below are the ones for a 1 GB
# machine, and docs/deployment.md section 4 explains what each one buys.
#
# The one worth knowing about without reading anything else is the thread pool.
# GlassFish ships it at five threads, which is the number of people the
# application can serve at once, and five is not many given how many request
# paths block on something slow.
# TM_HTTP_THREADS_MIN=8
# TM_HTTP_THREADS_MAX=24
# TM_HTTP_QUEUE_SIZE=256

# The JVM. Bounded in every direction that can otherwise grow without limit on
# a small host.
# TM_JVM_HEAP_MB=384
# TM_JVM_METASPACE_MB=192
# TM_JVM_DIRECT_MEMORY_MB=64
# TM_JVM_THREAD_STACK_KB=512

# The JDBC pool. max-pool-size has to stay under PostgreSQL's max_connections,
# which the tuning docs set to 20. TM_DB_STATEMENT_TIMEOUT caps any single
# statement so one bad query cannot hold a connection forever.
# TM_DB_POOL_STEADY=3
# TM_DB_POOL_MAX=16
# TM_DB_STATEMENT_TIMEOUT=30

# Log rotation. The default keeps three files of 100 MB each.
# TM_LOG_ROTATION_MB=10
# TM_LOG_HISTORY_FILES=5

# How long a mail conversation may take before it is abandoned, in
# milliseconds. JavaMail has no timeout by default, so a mail server that goes
# quiet mid-conversation holds the sending thread indefinitely.
# TM_MAIL_TIMEOUT_MS=10000

# --- what the build produces ------------------------------------------------
# These are not read here; they are Maven properties, changed by the `dev`
# profile. Noted because the difference matters and is invisible in the archive.
#
#   mvn clean package         Production project stage, SQL logging off
#   mvn -Pdev clean package   Development project stage, SQL logging at FINE
#
# Build without -Pdev for anything you deploy. Development stops Mojarra
# caching Facelets templates, so every request re-parses the views it renders,
# and FINE logging writes every SQL statement and its parameters to the server
# log. That combination is what produced a 95 MB server.log.

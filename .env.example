# TripMate local settings.
#
# Copy to .env and edit. .env is not committed; this file is.
# Everything here is optional: each value falls back to the default shown.

# --- database --------------------------------------------------------------
# TM_DB_NAME=tripmate
# TM_DB_USER=tripmate
# TM_DB_PASSWORD=tripmate_dev_pw
# TM_DB_HOST=localhost
# TM_DB_PORT=5432

# --- mail ------------------------------------------------------------------
# With no host set, messages are rendered into the server log instead of sent.
# TM_MAIL_HOST=smtp.gmail.com
# TM_MAIL_PORT=587
# TM_MAIL_USER=you@example.com
# TM_MAIL_PASSWORD=
# TM_MAIL_FROM="TripMate <no-reply@example.com>"

# --- what the site shows ---------------------------------------------------
# The integration checks are a development tool, so the link to them is off
# unless a deployment asks for it.
TM_SHOW_DIAGNOSTICS=false

# The stack line under the footer. Written as plain text; the separator is a
# middle dot by convention.
TM_FOOTER_STACK=Jakarta EE 10 - GlassFish 7 - PostgreSQL

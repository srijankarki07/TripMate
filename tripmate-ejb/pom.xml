<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tripmate</groupId>
        <artifactId>tripmate-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tripmate-ejb</artifactId>
    <packaging>ejb</packaging>

    <name>TripMate :: EJB</name>
    <description>
        Business tier. JPA entities, DTOs, @Remote service interfaces, stateless
        session bean implementations, and the expense message-driven bean.
    </description>

    <dependencies>
        <!--
            Full Jakarta EE 10 platform API. Version and `provided` scope are
            inherited from the parent's dependencyManagement; GlassFish supplies
            these classes at runtime.
        -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
                persistence.xml is filtered so that the EclipseLink logging
                level can differ between a development build and a deployment
                one. See the `tripmate.eclipselink.logging.*` properties in the
                parent POM.

                Filtering is enabled for the whole resource directory rather
                than for that one file because META-INF is the only thing in it;
                if anything else is ever added here and contains a `${...}` that
                is meant literally, it will need excluding.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        TripMate persistence unit.

        transaction-type="JTA": transactions are demarcated by the EJB
        container, not by the application. Every session bean is stateless and
        container-managed, so a business method either commits as a whole or
        rolls back as a whole without any begin/commit in the code. This is the
        reason TripService can create a trip and its admin membership in one
        method and be certain both or neither are written.
    -->
    <persistence-unit name="tripmatePU" transaction-type="JTA">

        <description>TripMate — group trip planning and expense tracking</description>

        <!--
            Container-managed datasource, created by scripts/glassfish-setup.sh.
            The pool behind it holds the PostgreSQL connection details, so no
            credentials appear in this file.
        -->
        <jta-data-source>jdbc/tripmate</jta-data-source>

        <!--
            Classes are listed rather than discovered. With a dozen-odd entity
            classes an explicit list is cheap, and it makes the persistence
            unit's contents reviewable at a glance instead of depending on
            classpath scanning order.
        -->
        <class>com.tripmate.entity.User</class>
        <class>com.tripmate.entity.Trip</class>
        <class>com.tripmate.entity.TripMember</class>
        <class>com.tripmate.entity.ItineraryItem</class>
        <class>com.tripmate.entity.Expense</class>
        <class>com.tripmate.entity.ExpenseSplit</class>
        <class>com.tripmate.entity.Settlement</class>
        <class>com.tripmate.entity.PasswordReset</class>
        <class>com.tripmate.entity.EmailVerification</class>
        <class>com.tripmate.entity.TripSummaryEmail</class>
        <class>com.tripmate.entity.TripCalendarFeed</class>
        <class>com.tripmate.entity.GoogleCalendarLink</class>
        <class>com.tripmate.entity.GoogleCalendarEvent</class>
        <class>com.tripmate.entity.PastTrip</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <!--
            No second-level cache.

            EclipseLink enables a shared cache by default, and it is the wrong
            default here. The database is reloaded underneath a running server
            routinely: database/load.sh and scripts/clean-deploy.sh both drop and
            reseed every table while the application stays up. The shared cache
            survives that, so the application keeps serving the entities it read
            before the reload and the new rows are invisible.

            The symptoms are confusing rather than obvious. A reseeded database
            and a running server disagree about a user's name, a password that
            was changed before the reload still works and the seeded one does
            not, and the entity round-trip on the diagnostics page reports that a
            row read back after clear() is missing, because clear() empties the
            persistence context and not the shared cache.

            NONE is the JPA-standard switch and is honoured by any provider, so
            this does not tie the mapping to EclipseLink. The cost is that every
            read goes to the database, which for an application of this size is
            nothing next to being wrong about who somebody is.
        -->
        <shared-cache-mode>NONE</shared-cache-mode>

        <properties>

            <!--
                CRITICAL: the schema is owned by database/schema.sql, not by JPA.

                Leaving DDL generation at its default would let the provider
                create or alter tables at deploy time. That is a silent
                disaster here: the schema carries CHECK constraints, partial
                referential actions and nine deliberate indexes that no
                generated DDL would reproduce, and a generated schema would
                quietly diverge from the one the report documents.

                `none` means the provider only ever maps to what already
                exists. If a mapping disagrees with a column, the failure is a
                loud error rather than a silent table alteration.
            -->
            <property name="eclipselink.ddl-generation" value="none"/>

            <!--
                SQL logging, substituted at build time from the properties in
                the parent POM. Quiet by default; FINE under the `dev` profile.

                This is the single largest thing the application was doing to
                itself. At FINE every query logged the full statement and every
                bound parameter, on every request, and the log had reached 95 MB
                with three 100 MB rotations beside it. The cost is not only disk:
                building the line means converting every parameter to a string,
                and on a machine where the log is on block storage, writing tens
                of megabytes costs more CPU than the queries did. Logging
                parameters also writes user data, including names and addresses
                pulled from the database, into a file that outlives the request.

                It stays available because it is genuinely useful: `mvn -Pdev`
                turns it back on, which is what the demo wants when the point is
                to show the ORM working.

                `logging.level.sql` is set to the same value so that the SQL
                logger does not outlive the level that is meant to bound it.
            -->
            <property name="eclipselink.logging.level" value="${tripmate.eclipselink.logging.level}"/>
            <property name="eclipselink.logging.level.sql" value="${tripmate.eclipselink.logging.level}"/>
            <property name="eclipselink.logging.parameters" value="${tripmate.eclipselink.logging.parameters}"/>

            <!-- Drop the EclipseLink connection from the pool between
                 transactions so a long-idle pool entry cannot go stale. -->
            <property name="eclipselink.transaction.join-existing" value="false"/>

        </properties>
    </persistence-unit>

</persistence>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tripmate</groupId>
        <artifactId>tripmate-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tripmate-web</artifactId>
    <packaging>war</packaging>

    <name>TripMate :: Web</name>
    <description>
        Presentation tier. Jakarta Faces views (XHTML), CDI backing beans, and
        web resources.
    </description>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
        </dependency>

        <!-- JSF component library. Version and the jakarta classifier come from
             the parent's dependencyManagement. Bundled in the WAR, because a
             component library is application code rather than platform code. -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <classifier>jakarta</classifier>
        </dependency>

        <!--
            Business tier. Scope `provided`: the interfaces and DTOs are needed
            to compile against, but they must NOT be copied into the WAR. At
            runtime the classes come from the EJB jar sitting alongside this WAR
            inside the EAR, which is why the two modules must agree on exactly
            one copy of every shared class.
        -->
        <dependency>
            <groupId>com.tripmate</groupId>
            <artifactId>tripmate-ejb</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <!--
                        web.xml is taken out of the ordinary webapp copy and put
                        back by the filtered resource below, so that the build
                        produces exactly one web.xml and it is the substituted
                        one.

                        The exclusion is what makes this work. The main webapp
                        tree is copied after the extra resources, so without it
                        the unfiltered file simply overwrites the filtered one
                        and the placeholder arrives in the archive unfilled,
                        with nothing anywhere reporting a problem. Excluding it
                        here removes the ordering question rather than relying
                        on it.
                    -->
                    <warSourceExcludes>WEB-INF/web.xml</warSourceExcludes>
                    <webResources>
                        <!--
                            The directory is the webapp root and not WEB-INF,
                            because an extra resource is copied to a path
                            relative to its own directory. Pointing at WEB-INF
                            would put web.xml in the root of the archive, where
                            the container does not look for it, rather than in
                            WEB-INF.
                        -->
                        <resource>
                            <directory>src/main/webapp</directory>
                            <filtering>true</filtering>
                            <includes>
                                <include>WEB-INF/web.xml</include>
                            </includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

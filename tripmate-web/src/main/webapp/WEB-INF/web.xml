<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>TripMate</display-name>

    <!--
        The Faces project stage. Substituted at build time from the
        `tripmate.projectStage` property in the parent POM, which is Production
        by default and Development under the `dev` profile.

        It is worth understanding what this actually changes, because it is the
        difference between a page being re-parsed and being cached. In the
        Development stage Mojarra stops caching Facelets templates, so every
        request re-checks each view it renders for changes and re-parses it if
        the timestamp moved. That is what you want while editing XHTML, and it
        is a per-request cost on a server that is not going to change its
        templates at all. Production caches them.

        Mojarra resolves the stage from this init parameter or from the JNDI
        entry java:comp/env/faces/ProjectStage, and there is no system-property
        or environment fallback, which is why this is a build-time substitution
        rather than something the deployment scripts can set. If the parameter
        is absent altogether the stage is Production anyway, so a build that
        loses the substitution fails safe.
    -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>${tripmate.projectStage}</param-value>
    </context-param>

    <!--
        PrimeFaces theme. "saga" is the closest of the bundled themes to the
        design system in DESIGN.md: light surfaces, restrained type, no strong
        brand colour of its own. Everything brand-critical is overridden in
        resources/css/tripmate.css, so the theme supplies structure and spacing
        while the tokens supply colour, type and shape.
    -->
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <!-- Icon font for PrimeFaces components. -->
    <context-param>
        <param-name>primefaces.FONT_AWESOME</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Uploads and client-side validation are not used yet; leaving the
         defaults on would pull in extra scripts for nothing. -->
    <context-param>
        <param-name>primefaces.CLIENT_SIDE_VALIDATION</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- Faces view state is per-session by default; keep it that way so a
         browser refresh never replays a stale POST. -->
    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <!--
        How many views a single session may keep state for.

        Server-side state saving keeps the whole component tree of each view,
        plus the fields of every @ViewScoped bean behind it, in that user's
        session until the view is evicted. They are evicted in least-recently-
        used order, and the number held at once is what these two settings
        decide: the last N views in the session, and the last N logical views
        across postbacks.

        Left unset, Mojarra's defaults are 15 and 15. On a machine where the
        heap is 384 MB that is a lot of retained trees per session, and it
        compounds with the thirty-day session timeout set below: a session that
        nobody has touched for a month still holds all of it. A trip detail view
        here carries nine collections, so the difference between 15 views and 5
        is tens of megabytes across a handful of users, which is the difference
        between fitting and not fitting.

        Five is chosen to be well past what a person actually navigates back
        through. The visible effect of going too low is that the Back button
        re-renders a stale page instead of restoring it, which is worth knowing
        if this is ever tuned further down.
    -->
    <context-param>
        <param-name>jakarta.faces.NUMBER_OF_VIEWS_IN_SESSION</param-name>
        <param-value>5</param-value>
    </context-param>
    <context-param>
        <param-name>jakarta.faces.NUMBER_OF_LOGICAL_VIEWS_IN_SESSION</param-name>
        <param-value>5</param-value>
    </context-param>

    <!--
        A web manifest is only honoured when it is served as
        application/manifest+json. GlassFish has no default mapping for the
        extension, so without this the browser fetches the file, sees
        text/plain or an octet stream, and silently ignores it.
    -->
    <mime-mapping>
        <extension>webmanifest</extension>
        <mime-type>application/manifest+json</mime-type>
    </mime-mapping>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

    <!--
        How long a signed-in session lasts.

        There was no session-config here at all, so the container's own default
        applied: thirty minutes. On an application people open, leave, and come
        back to, that means signing in again most times they return, which is
        what was reported.

        Thirty days, and the two halves of that are separate things that both
        have to be set.

        session-timeout is measured in minutes and is the server's own idle
        limit: it is what expires a session nobody has used. The cookie's
        max-age is measured in seconds and decides whether the browser keeps
        the session id at all. With only the first set the session would still
        be valid on the server while the browser had already thrown the id
        away, which looks exactly the same to the reader as the session
        expiring, and is the reason changing one alone would not have fixed
        anything.

        HttpOnly stays on: the session id is a bearer credential for the whole
        account and no script in this application has any reason to read it.
        SameSite is left at the container's default, which is Lax, and that is
        the right value here: it is sent on top-level navigation, so following
        a link back into the application keeps the session, while a cross-site
        form post does not carry it.

        Thirty days is a real trade. A stolen session id is usable for as long
        as it lives, and this makes that window much longer. It is accepted
        because the alternative was reported as a defect in its own right, and
        because the account holds trip planning data rather than anything
        financial. The mitigations that matter are already in place: the id is
        rotated on sign-in, which closes session fixation, and signing out
        invalidates the session server-side rather than only dropping the
        cookie.
    -->
    <session-config>
        <session-timeout>43200</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <max-age>2592000</max-age>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>

<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>TripMate</display-name>

    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <!--
        PrimeFaces theme. "saga" is the closest of the bundled themes to the
        design system in DESIGN.md: light surfaces, restrained type, no strong
        brand colour of its own. Everything brand-critical is overridden in
        resources/css/tripmate.css, so the theme supplies structure and spacing
        while the tokens supply colour, type and shape.
    -->
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <!-- Icon font for PrimeFaces components. -->
    <context-param>
        <param-name>primefaces.FONT_AWESOME</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Uploads and client-side validation are not used yet; leaving the
         defaults on would pull in extra scripts for nothing. -->
    <context-param>
        <param-name>primefaces.CLIENT_SIDE_VALIDATION</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- Faces view state is per-session by default; keep it that way so a
         browser refresh never replays a stale POST. -->
    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <!--
        A web manifest is only honoured when it is served as
        application/manifest+json. GlassFish has no default mapping for the
        extension, so without this the browser fetches the file, sees
        text/plain or an octet stream, and silently ignores it.
    -->
    <mime-mapping>
        <extension>webmanifest</extension>
        <mime-type>application/manifest+json</mime-type>
    </mime-mapping>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

</web-app>
